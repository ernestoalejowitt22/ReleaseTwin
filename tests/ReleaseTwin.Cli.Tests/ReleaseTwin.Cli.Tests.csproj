<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- local-evidence-viewer: the shared evidence-document fixtures, byte-identical twins of the
         platform repo's copies. Read from the output directory so a test never depends on where the
         repo is checked out. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReleaseTwin.Cli\ReleaseTwin.Cli.csproj" />
    <ProjectReference Include="..\..\src\ReleaseTwin.Core\ReleaseTwin.Core.csproj" />
    <ProjectReference Include="..\..\src\ReleaseTwin.AdapterSdk\ReleaseTwin.AdapterSdk.csproj" />
    <ProjectReference Include="..\..\src\ReleaseTwin.Adapters.AzureDevOps\ReleaseTwin.Adapters.AzureDevOps.csproj" />
    <ProjectReference Include="..\..\src\ReleaseTwin.Adapters.Http\ReleaseTwin.Adapters.Http.csproj" />
    <ProjectReference Include="..\..\src\ReleaseTwin.Adapters.LaunchDarkly\ReleaseTwin.Adapters.LaunchDarkly.csproj" />
    <ProjectReference Include="..\..\src\ReleaseTwin.Adapters.Ui\ReleaseTwin.Adapters.Ui.csproj" />
  </ItemGroup>

</Project>
