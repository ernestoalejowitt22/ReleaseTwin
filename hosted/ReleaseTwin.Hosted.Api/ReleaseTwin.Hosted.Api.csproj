<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.5" />
    <PackageReference Include="Amazon.AspNetCore.DataProtection.SSM" Version="4.0.3" />
    <!-- operator-alerting: the daily staleness digest publishes to SNS. -->
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="4.0.100" />
    <!-- evidence-purge-and-blob-store: S3EvidenceBlobStore. v4 line, matching the AWSSDK.Core
         the DynamoDB/SNS packages already pull. -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.6" />
  </ItemGroup>

</Project>
