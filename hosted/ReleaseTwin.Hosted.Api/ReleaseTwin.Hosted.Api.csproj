<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- plan-catalog-and-entitlements: the single plan catalog lives at hosted/plans.json (BSL side,
         same license as web/ which also reads it) and is embedded here for enforcement. Manifest
         name: ReleaseTwin.Hosted.Api.Plans.plans.json (see PlanCatalog.Load). -->
    <EmbeddedResource Include="..\plans.json" Link="Plans\plans.json" />
    <!-- add-feature-flag-seam: the single feature-flag registry lives at the repo root (imported
         directly by web/, embedded here and in the CLI). Manifest name:
         ReleaseTwin.Hosted.Api.Flags.flags.json (see FlagRegistry.Load). -->
    <EmbeddedResource Include="..\..\flags.json" Link="Flags\flags.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.5" />
    <PackageReference Include="Amazon.AspNetCore.DataProtection.SSM" Version="4.0.3" />
    <!-- operator-alerting: the daily staleness digest publishes to SNS. -->
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="4.0.100" />
    <!-- company-and-domain-launch: SesInvitationEmailSender delivers org invites via SES v2, bound
         only when Notifications:FromAddress is set. Same AWSSDK.Core v4 line as the SNS/S3 clients. -->
    <PackageReference Include="AWSSDK.SimpleEmailV2" Version="4.0.0.11" />
    <!-- run-notifications: the ingest path enqueues a failure-notification message; a second Lambda
         (RELEASETWIN_LAMBDA_TASK=NotificationDispatch) drains the queue. v4 line, matching AWSSDK.Core. -->
    <PackageReference Include="AWSSDK.SQS" Version="4.0.0.13" />
    <!-- evidence-purge-and-blob-store: S3EvidenceBlobStore. v4 line, matching the AWSSDK.Core
         the DynamoDB/SNS packages already pull. -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.6" />
    <PackageReference Include="OpenFeature" Version="2.14.1" />
    <!-- supply-chain-and-ci-hardening: Amazon.AspNetCore.DataProtection.SSM → Microsoft.AspNetCore.DataProtection
         10.0.7 pulls System.Security.Cryptography.Xml 10.0.7, which carries High-severity advisories
         (GHSA-cvvh-rhrc-wg4q and siblings). Pin the transitive dependency forward to the patched
         line until the SSM package updates its own floor. NU1510: the package is framework-provided
         and pruned from the shipped output, so the explicit reference only affects restore-graph
         analysis (which is what the dependency scan reads) — that is exactly what we want here. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" NoWarn="NU1510" />
  </ItemGroup>

</Project>
