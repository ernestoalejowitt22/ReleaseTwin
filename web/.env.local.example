# Copy to web/.env.local and fill in. Loaded by `next dev`, cypress.config.ts, and the
# scripts/e2e-api*.mjs helpers. Never commit the real .env.local.

# Clerk (your instance — dev instances look like <slug>.clerk.accounts.dev)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# The Clerk Frontend API domain — the JWT issuer ReleaseTwin.Hosted.Api validates against.
# Same instance as the publishable key above.
CLERK_DOMAIN=<slug>.clerk.accounts.dev

# The hosted API the dashboard talks to (server-side only). Local default: http://localhost:5199
RELEASETWIN_API_URL=http://localhost:5199
