<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ReleaseTwin.Core\ReleaseTwin.Core.csproj" />
    <ProjectReference Include="..\ReleaseTwin.AdapterSdk\ReleaseTwin.AdapterSdk.csproj" />
    <ProjectReference Include="..\ReleaseTwin.Adapters.AzureDevOps\ReleaseTwin.Adapters.AzureDevOps.csproj" />
    <ProjectReference Include="..\ReleaseTwin.Adapters.Http\ReleaseTwin.Adapters.Http.csproj" />
    <ProjectReference Include="..\ReleaseTwin.Adapters.LaunchDarkly\ReleaseTwin.Adapters.LaunchDarkly.csproj" />
    <ProjectReference Include="..\ReleaseTwin.Adapters.Ui\ReleaseTwin.Adapters.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scaffolding\Templates\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- supply-chain-and-ci-hardening: 3.1.5 carries High-severity advisories (e.g. GHSA-2cmq-823j-5qj8);
         3.1.x patch line is a drop-in. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- cli-distribution: also ship the CLI as a .NET global tool on nuget.org
       (`dotnet tool install -g releasetwin`) for users who have the .NET runtime
       but don't want a container or a source checkout. `dotnet pack` bundles the
       adapter project references and NuGet dependencies into the nupkg. Framework-
       dependent by design — the no-runtime case is what the Docker image is for. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>releasetwin</ToolCommandName>
    <PackageId>releasetwin</PackageId>
    <Title>ReleaseTwin CLI</Title>
    <Authors>Ernesto Alejo and the ReleaseTwin contributors</Authors>
    <Description>Release-proof testing for integration-heavy, feature-flagged systems: evidence-linked cases, immutable fixtures, and paired known-bad/known-good "flag proof". Runs entirely in your own infrastructure; exits non-zero on any case failure so it drops into CI as a required check. UI-journey cases additionally need `playwright install`.</Description>
    <PackageProjectUrl>https://github.com/ernestoalejowitt22/ReleaseTwin</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ernestoalejowitt22/ReleaseTwin</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- NuGet's PackageLicenseExpression only accepts SPDX-listed ids, so it can't carry the
         `WITH LicenseRef-ReleaseTwin-Adapter-Exception` clause. That exception exists for
         third parties who *link* the AdapterSdk to write an adapter — the CLI executable
         itself is plain AGPL-3.0, so this is the correct expression for this package. -->
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>testing;integration-testing;feature-flags;ci;release;flag-proof</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!-- NU5111: the Ui adapter bundles Playwright's browser-install .ps1 helpers as content.
         They are legitimately not NuGet install/uninstall lifecycle scripts, so the warning
         is noise — suppress just this code, not the security advisories on ImageSharp. -->
    <NoWarn>$(NoWarn);NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
